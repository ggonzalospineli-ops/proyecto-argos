# Base de datos
DATABASE_URL="postgresql://user:password@localhost:5432/argos_platform"

# Sesion (auth propia por credenciales, ver lib/auth.ts)
SESSION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Storage de artifacts: "local" (dev, filesystem) o "s3" (no implementado todavia, ver ARTIFACT_MODEL.md)
ARTIFACT_STORAGE_DRIVER="local"
ARTIFACT_STORAGE_LOCAL_PATH=".data/artifacts"

# AI assistant (opcional — si no esta seteado, el endpoint responde con error claro)
AI_PROVIDER="anthropic"
AI_API_KEY=""
AI_MODEL="claude-sonnet-5"
